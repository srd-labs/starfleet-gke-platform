      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Application Error Rate Over Time",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-bigquery-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "afx61mcw7rvnkd"
                      },
                      "spec": {
                        "dataset": "starfleet_gke_logs",
                        "editorMode": "code",
                        "format": 1,
                        "location": "",
                        "project": "starfleet-gke-platform-lab",
                        "rawQuery": true,
                        "rawSql": "WITH requests AS (\n  SELECT\n    timestamp,\n    SAFE_CAST(\n      REGEXP_EXTRACT(\n        textPayload,\n        r'HTTP/[0-9.]+\" ([0-9]{3})'\n      ) AS INT64\n    ) AS status_code\n  FROM `starfleet-gke-platform-lab.starfleet_gke_logs.stderr`\n  WHERE $__timeFilter(timestamp)\n    AND textPayload LIKE '%werkzeug%'\n)\n\nSELECT\n  TIMESTAMP_TRUNC(timestamp, MINUTE) AS time,\n  ROUND(\n    SAFE_DIVIDE(\n      COUNTIF(status_code >= 500),\n      COUNTIF(status_code IS NOT NULL)\n    ) * 100, 4\n  ) AS error_rate_percent\nFROM requests\nGROUP BY time\nORDER BY time",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.0",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [],
